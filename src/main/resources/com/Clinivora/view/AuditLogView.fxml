<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.Clinivora.ui.AuditLogController"
      spacing="10"
      xmlns:fx="http://javafx.com/fxml">
    <Label text="Audit log" styleClass="section-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="actionField" promptText="Action contains" prefWidth="180"/>
        <TextField fx:id="fromField" promptText="From yyyy-MM-dd HH:mm:ss" prefWidth="180"/>
        <TextField fx:id="toField" promptText="To yyyy-MM-dd HH:mm:ss" prefWidth="180"/>
        <Button text="Filter" styleClass="primary-button" onAction="#onFilter"/>
        <Button text="Clear" styleClass="secondary-button" onAction="#onClear"/>
    </HBox>
    <TableView fx:id="auditTable" prefHeight="440">
        <placeholder>
            <Label text="No audit rows for this filter." styleClass="empty-state"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="createdCol" text="When" prefWidth="150"/>
            <TableColumn fx:id="actionCol" text="Action" prefWidth="160"/>
            <TableColumn fx:id="entityCol" text="Entity" prefWidth="120"/>
            <TableColumn fx:id="entityIdCol" text="ID" prefWidth="60"/>
            <TableColumn fx:id="userCol" text="User #" prefWidth="70"/>
            <TableColumn fx:id="detailsCol" text="Details" prefWidth="260"/>
        </columns>
    </TableView>
</VBox>
