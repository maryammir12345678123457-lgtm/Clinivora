<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.Clinivora.ui.DsaLabController"
      spacing="12"
      xmlns:fx="http://javafx.com/fxml">
    <Label text="DSA Laboratory" styleClass="section-title"/>
    <Label text="Course DSAs: ArrayList · HashMap · Priority Queue · Linked List · Stack (custom implementations)"
          styleClass="muted" wrapText="true"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="structureBox" prefWidth="280"/>
        <ComboBox fx:id="operationBox" prefWidth="160"/>
        <TextField fx:id="valueField" promptText="Value / key" prefWidth="140"/>
        <Button text="Run" styleClass="primary-button" onAction="#onRun"/>
        <Button text="How to use" styleClass="secondary-button" onAction="#onGuide"/>
        <Button text="Try sample" styleClass="secondary-button" onAction="#onTrySample"/>
        <Button text="Reset sample" styleClass="ghost-button" onAction="#onReset"/>
        <Button text="Benchmark Priority Queue vs list" styleClass="ghost-button" onAction="#onBenchmark"/>
    </HBox>
    <Label fx:id="complexityLabel" styleClass="muted"/>
    <VBox styleClass="card" spacing="8">
        <Label text="Visualizer" styleClass="section-title"/>
        <FlowPane fx:id="visualizerPane" hgap="8" vgap="8" prefHeight="120"/>
        <TextArea fx:id="stateArea" prefRowCount="6" editable="false" wrapText="true"/>
    </VBox>
    <VBox styleClass="card" spacing="6">
        <Label text="Benchmark" styleClass="section-title"/>
        <ProgressBar fx:id="benchmarkProgress" prefWidth="420" progress="0"/>
        <Label fx:id="benchmarkLabel" styleClass="muted" wrapText="true"/>
    </VBox>
</VBox>
