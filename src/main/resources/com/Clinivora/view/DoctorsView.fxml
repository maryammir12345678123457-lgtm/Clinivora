<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.Clinivora.ui.DoctorsController"
      spacing="10"
      xmlns:fx="http://javafx.com/fxml">
    <Label text="Doctors" styleClass="section-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="nameField" promptText="Full name" prefWidth="200"/>
        <TextField fx:id="specialtyField" promptText="Specialty" prefWidth="160"/>
        <Button fx:id="addButton" text="Add doctor" styleClass="primary-button" onAction="#onAdd"/>
        <Button text="Toggle availability" styleClass="secondary-button" onAction="#onToggle"/>
        <Button fx:id="deactivateButton" text="Deactivate" styleClass="danger-button" onAction="#onDeactivate"/>
        <Button fx:id="activateButton" text="Activate" styleClass="ghost-button" onAction="#onActivate"/>
        <CheckBox fx:id="showInactiveBox" text="Show inactive" onAction="#onRefresh"/>
        <Button text="Refresh" styleClass="ghost-button" onAction="#onRefresh"/>
    </HBox>
    <TableView fx:id="doctorTable" prefHeight="420">
        <placeholder>
            <Label text="No doctors to display." styleClass="empty-state"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="codeCol" text="Code" prefWidth="100"/>
            <TableColumn fx:id="nameCol" text="Name" prefWidth="170"/>
            <TableColumn fx:id="specialtyCol" text="Specialty" prefWidth="150"/>
            <TableColumn fx:id="availableCol" text="Available" prefWidth="90"/>
            <TableColumn fx:id="activeCol" text="Active" prefWidth="90"/>
        </columns>
    </TableView>
</VBox>
