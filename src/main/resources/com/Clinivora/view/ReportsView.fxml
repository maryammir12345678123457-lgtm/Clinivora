<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.Clinivora.ui.ReportsController"
      spacing="12"
      xmlns:fx="http://javafx.com/fxml">
    <Label text="Reports workspace" styleClass="section-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <Label text="From"/>
        <DatePicker fx:id="startPicker"/>
        <Label text="To"/>
        <DatePicker fx:id="endPicker"/>
        <ComboBox fx:id="statusFilter" prefWidth="160"/>
        <Button text="Refresh" styleClass="primary-button" onAction="#onRefresh"/>
        <Button text="Export PDF" styleClass="secondary-button" onAction="#onExportPdf"/>
        <Button text="Export CSV" styleClass="ghost-button" onAction="#onExportCsv"/>
    </HBox>
    <HBox spacing="12">
        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Case status mix" styleClass="section-title"/>
            <PieChart fx:id="statusPie" prefHeight="240" legendVisible="true"/>
        </VBox>
        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Daily arrivals" styleClass="section-title"/>
            <BarChart fx:id="arrivalsBar" prefHeight="240" legendVisible="false">
                <xAxis>
                    <CategoryAxis label="Day"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Cases"/>
                </yAxis>
            </BarChart>
        </VBox>
    </HBox>
    <VBox styleClass="card" spacing="6">
        <Label text="Summary" styleClass="section-title"/>
        <TextArea fx:id="summaryArea" prefRowCount="5" wrapText="true" editable="false"/>
    </VBox>
    <VBox styleClass="card" spacing="6" VBox.vgrow="ALWAYS">
        <Label text="Detailed cases" styleClass="section-title"/>
        <TableView fx:id="detailTable" prefHeight="240">
            <placeholder>
                <Label text="No cases in this range." styleClass="empty-state"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="caseCol" text="Case" prefWidth="100"/>
                <TableColumn fx:id="patientCodeCol" text="Patient" prefWidth="100"/>
                <TableColumn fx:id="patientNameCol" text="Name" prefWidth="140"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="110"/>
                <TableColumn fx:id="arrivalCol" text="Arrival" prefWidth="140"/>
                <TableColumn fx:id="complaintCol" text="Complaint" prefWidth="180"/>
                <TableColumn fx:id="priorityCol" text="ESI" prefWidth="70"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
