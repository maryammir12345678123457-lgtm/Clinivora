<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.Clinivora.ui.RoutineQueueController"
      spacing="12"
      xmlns:fx="http://javafx.com/fxml">
    <Label text="Routine queue (CircularQueue)" styleClass="section-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="patientBox" prefWidth="320" promptText="Select patient"/>
        <Button text="Enqueue" styleClass="primary-button" onAction="#onEnqueue"/>
        <Button text="Serve next" styleClass="secondary-button" onAction="#onServeNext"/>
        <Button text="Refresh" styleClass="ghost-button" onAction="#onRefresh"/>
    </HBox>
    <TableView fx:id="ticketTable" prefHeight="420">
        <columns>
            <TableColumn fx:id="codeCol" text="Ticket" prefWidth="120"/>
            <TableColumn fx:id="queueCol" text="#" prefWidth="60"/>
            <TableColumn fx:id="patientCol" text="Patient #" prefWidth="100"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="110"/>
            <TableColumn fx:id="createdCol" text="Created" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
