<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:controller="com.Clinivora.ui.PatientsController"
           xmlns:fx="http://javafx.com/fxml">
    <VBox spacing="10">
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
            <TextField fx:id="searchField" promptText="Search by name" prefWidth="240"/>
            <Button text="Search" styleClass="secondary-button" onAction="#onSearch"/>
            <Button fx:id="newButton" text="New patient" styleClass="primary-button" onAction="#onShowForm"/>
            <Button fx:id="editButton" text="Edit" styleClass="secondary-button" onAction="#onEdit"/>
            <Button fx:id="deleteButton" text="Delete" styleClass="danger-button" onAction="#onDelete"/>
            <Button fx:id="restoreButton" text="Restore" styleClass="ghost-button" onAction="#onRestore"/>
            <Button text="Open profile" styleClass="ghost-button" onAction="#onOpenProfile"/>
            <Button fx:id="openCaseButton" text="Open ER case" styleClass="ghost-button" onAction="#onOpenEmergency"/>
            <CheckBox fx:id="showInactiveBox" text="Show inactive" onAction="#onSearch"/>
        </HBox>
        <TableView fx:id="patientTable" VBox.vgrow="ALWAYS" prefHeight="420">
            <placeholder>
                <Label text="No patients match this view." styleClass="empty-state"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="codeCol" text="Code" prefWidth="100"/>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="170"/>
                <TableColumn fx:id="phoneCol" text="Phone" prefWidth="120"/>
                <TableColumn fx:id="genderCol" text="Gender" prefWidth="80"/>
                <TableColumn fx:id="dobCol" text="DOB" prefWidth="100"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>

    <VBox fx:id="formOverlay" managed="false" visible="false" alignment="CENTER"
          style="-fx-background-color: rgba(20,42,59,0.45);">
        <VBox styleClass="card" spacing="10" maxWidth="520">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
            <Label fx:id="formTitle" text="Register patient" styleClass="section-title"/>
            <GridPane hgap="10" vgap="8">
                <Label text="First name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Last name" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="DOB" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dobPicker" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Phone" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Gender" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="genderBox" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="200"/>
                <Label text="National ID" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <TextField fx:id="nationalIdField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                <Label text="Address" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                <Label text="Emergency contact" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextField fx:id="emergencyField" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            </GridPane>
            <HBox spacing="8">
                <Button text="Undo field" styleClass="secondary-button" onAction="#onUndo"/>
                <Button text="Save" styleClass="primary-button" onAction="#onSave"/>
                <Button text="Cancel" styleClass="ghost-button" onAction="#onHideForm"/>
            </HBox>
            <Label fx:id="formMessage" styleClass="muted"/>
        </VBox>
    </VBox>
</StackPane>
